# ============================================================================
# Enterprise Checkout System - Environment Configuration Template
# ============================================================================

# Application Environment
NODE_ENV="development"
PORT=3000

# PostgreSQL Database URL (Matches docker-compose.yml credentials)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres_user:secure_password_123@localhost:5432/enterprise_checkout_db?schema=public"

# Redis Distributed Lock & Idempotency Cache URL
REDIS_URL="redis://localhost:6379"

# Stripe Connect PSP Configuration
STRIPE_SECRET_KEY="sk_test_51MockEnterpriseSecretKeyHere..."
STRIPE_WEBHOOK_SECRET="whsec_mockEnterpriseWebhookSigningSecretHere..."

# Application Security & Audit
IDEMPOTENCY_TTL_SECONDS=86400
PLATFORM_FEE_BASIS_POINTS=250
