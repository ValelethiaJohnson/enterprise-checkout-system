# ==========================================
# ENTERPRISE CHECKOUT SYSTEM - ENVIRONMENT CONFIGURATION
# ==========================================

# Database & ORM (PostgreSQL with Prisma)
DATABASE_URL="postgresql://db_user:secure_password@localhost:5432/enterprise_checkout?schema=public&sslmode=prefer"

# Application Server
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# Redis & Distributed Concurrency Locks / Workers
REDIS_URL="redis://default:secure_redis_password@localhost:6379"

# Payment Gateway Integration (Stripe Principal Setup)
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CURRENCY="usd"

# Security & Session Expiry Policy
SESSION_EXPIRY_MINUTES=15
IDEMPOTENCY_HEADER_KEY="Idempotency-Key"

# Observability & Audit Logging
LOG_LEVEL="info"
AUDIT_LOG_ENABLED="true"
