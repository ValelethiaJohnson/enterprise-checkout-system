{
  "name": "enterprise-checkout-system",
  "version": "1.0.0",
  "description": "Enterprise-grade e-commerce checkout architecture featuring idempotent payment pipelines, distributed transactions, and inventory concurrency controls.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:concurrency": "vitest run tests/concurrency"
  },
  "keywords": [
    "fintech",
    "payment-gateway",
    "checkout-system",
    "distributed-transactions",
    "idempotency",
    "stripe-connect",
    "immutable-ledger"
  ],
  "author": "Valelethia Johnson <valelethiajohnson927@hotmail.com> (https://github.com/ValelethiaJohnson)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValelethiaJohnson/enterprise-checkout-system.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^6.0.0",
    "pino": "^9.4.0",
    "stripe": "^16.12.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^9.10.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
